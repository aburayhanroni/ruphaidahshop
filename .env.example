# Ruphaidah Shop Management System (RSMS) - Environment Configuration
# Copy this file to .env.local for local development.
# NEVER commit real credentials, service-role keys, or production secrets to Git.

# Supabase Project Configuration (Publishable client settings only)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key-placeholder

# Application Settings
VITE_APP_NAME="Ruphaidah Shop Management System"
VITE_APP_TIMEZONE="Asia/Dhaka"
VITE_APP_DEFAULT_LOCALE="en-BD"
VITE_APP_CURRENCY="BDT"
